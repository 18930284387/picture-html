+  // 过滤照片：按搜索和分类
+  const filteredPhotos = photos
+    // 先按分类过滤
+    .filter(photo => {
+      if (activeCategory === 'follows') {
+        return isFollowing[photo.author] === true;
+      }
+      // 其他分类都显示所有
+      return true;
+    })
+    // 然后按搜索过滤
+    .filter(photo => {
+      if (!searchQuery.trim()) {
+        return true;
+      }
+      const lowerQuery = searchQuery.toLowerCase();
+      return (
+        photo.title.toLowerCase().includes(lowerQuery) ||
+        photo.author.toLowerCase().includes(lowerQuery) ||
+        photo.tags.some(tag => tag.toLowerCase().includes(lowerQuery))
+      );
+    })
+    // 最后排序
+    .sort((a, b) => {
+      if (activeCategory === 'hot') {
+        // Hot：按点赞数+评论数排序
+        const scoreA = a.likes + a.comments.length * 10;
+        const scoreB = b.likes + b.comments.length * 10;
+        return scoreB - scoreA;
+      } else if (activeCategory === 'trending') {
+        // Trending：按点赞数排序
+        return b.likes - a.likes;
+      }
+      // 默认：保持原样（最新的在前面）
+      return 0;
+    });
  
