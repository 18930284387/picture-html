+};
+const maxVisibleReplyDepth = 3;
+
+const getCommentCount = (comments: Comment[]) => {
+  let count = 0;
+  const stack = [...comments];
+
+  while (stack.length > 0) {
+    const currentComment = stack.pop();
+
+    if (!currentComment) {
+      continue;
+    }
+
+    count += 1;
+
+    for (let index = currentComment.replies.length - 1; index >= 0; index -= 1) {
+      stack.push(currentComment.replies[index]);
+    }
+  }
+
+  return count;
+};
+
+const findCommentPath = (comments: Comment[], targetCommentId: number) => {
+  const stack = comments
+    .map((comment, index) => ({ comment, path: [index] }))
+    .reverse();
+
+  while (stack.length > 0) {
+    const currentNode = stack.pop();
+
+    if (!currentNode) {
+      continue;
+    }
+
+    if (currentNode.comment.id === targetCommentId) {
+      return currentNode.path;
+    }
+
+    for (let index = currentNode.comment.replies.length - 1; index >= 0; index -= 1) {
+      stack.push({
+        comment: currentNode.comment.replies[index],
+        path: [...currentNode.path, index]
+      });
+    }
+  }
+
+  return null;
+};
+
+const appendReplyToComments = (comments: Comment[], targetCommentId: number, reply: Comment) => {
+  const targetPath = findCommentPath(comments, targetCommentId);
+
+  if (!targetPath) {
+    return comments;
+  }
+
+  const nextComments = [...comments];
+  let currentLevel = nextComments;
+
+  for (let pathIndex = 0; pathIndex < targetPath.length - 1; pathIndex += 1) {
+    const currentIndex = targetPath[pathIndex];
+    currentLevel[currentIndex] = {
+      ...currentLevel[currentIndex],
+      replies: [...currentLevel[currentIndex].replies]
+    };
+    currentLevel = currentLevel[currentIndex].replies;
+  }
+
+  const targetIndex = targetPath[targetPath.length - 1];
+  currentLevel[targetIndex] = {
+    ...currentLevel[targetIndex],
+    replies: [...currentLevel[targetIndex].replies, reply]
+  };
+
+  return nextComments;
+};
+
+type VisibleReplyNode = {
+  comment: Comment;
+  actualDepth: number;
+  visualDepth: number;
+  canExpand: boolean;
+  hiddenReplyCount: number;
+};
+
+const flattenVisibleReplies = (replies: Comment[], expandedCommentIds: Set<number>): VisibleReplyNode[] => {
+  const visibleReplies: VisibleReplyNode[] = [];
+  const stack = replies
+    .map(reply => ({ comment: reply, depth: 1 }))
+    .reverse();
+
+  while (stack.length > 0) {
+    const currentNode = stack.pop();
+
+    if (!currentNode) {
+      continue;
+    }
+
+    const shouldCollapseChildren = currentNode.depth >= maxVisibleReplyDepth
+      && currentNode.comment.replies.length > 0
+      && !expandedCommentIds.has(currentNode.comment.id);
+
+    visibleReplies.push({
+      comment: currentNode.comment,
+      actualDepth: currentNode.depth,
+      visualDepth: Math.min(currentNode.depth, maxVisibleReplyDepth),
+      canExpand: shouldCollapseChildren,
+      hiddenReplyCount: shouldCollapseChildren ? getCommentCount(currentNode.comment.replies) : 0
+    });
+
+    if (currentNode.comment.replies.length === 0 || shouldCollapseChildren) {
+      continue;
+    }
+
+    for (let index = currentNode.comment.replies.length - 1; index >= 0; index -= 1) {
+      stack.push({
+        comment: currentNode.comment.replies[index],
+        depth: currentNode.depth + 1
+      });
+    }
+  }
+
+  return visibleReplies;
+};
 
